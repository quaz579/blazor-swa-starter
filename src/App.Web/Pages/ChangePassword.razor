@page "/change-password"
@inject PocAuthState Auth
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Change password</PageTitle>

@if (Auth.Enabled)
{
    <div data-testid="change-password-page">
        <h1>Change password</h1>

        @if (!_ready)
        {
            <p data-testid="change-password-loading">Loading…</p>
        }
        else if (!Auth.IsSignedIn)
        {
            <div class="alert alert-warning" role="alert" data-testid="change-password-signin-required">
                Sign in to change your password. <a href="login" data-testid="change-password-signin-link">Sign in</a>
            </div>
        }
        else
        {
            <p class="text-muted">Signed in as <strong>@Auth.User!.Username</strong>.@(_warning is null ? " Other devices are signed out when you change it." : "")</p>
            <EditForm Model="_form" OnSubmit="SubmitAsync" FormName="change-password">
                <div class="mb-3">
                    <label for="change-password-current" class="form-label">Current password</label>
                    <InputText id="change-password-current" type="password" class="form-control" data-testid="change-password-current" @bind-Value="_form.CurrentPassword" autocomplete="current-password" />
                </div>
                <div class="mb-3">
                    <label for="change-password-new" class="form-label">New password</label>
                    <InputText id="change-password-new" type="password" class="form-control" data-testid="change-password-new" @bind-Value="_form.NewPassword" autocomplete="new-password" />
                    <div class="form-text">At least 8 characters, with a letter and a digit.</div>
                </div>
                <div class="mb-3">
                    <label for="change-password-confirm" class="form-label">Confirm new password</label>
                    <InputText id="change-password-confirm" type="password" class="form-control" data-testid="change-password-confirm" @bind-Value="_form.ConfirmPassword" autocomplete="new-password" />
                </div>
                @if (_error is not null)
                {
                    <div class="alert alert-danger" role="alert" data-testid="change-password-error">@_error</div>
                }
                @if (_warning is not null)
                {
                    <div class="alert alert-warning" role="status" data-testid="change-password-warning">@_warning</div>
                }
                else if (_success)
                {
                    <div class="alert alert-success" role="status" data-testid="change-password-success">Your password was changed.</div>
                }
                <button type="submit" class="btn btn-primary" data-testid="change-password-submit" disabled="@_busy">Change password</button>
            </EditForm>
        }
    </div>
}

@code {
    private readonly ChangePasswordForm _form = new();
    private string? _error;
    private bool _success;
    private string? _warning;
    private bool _busy;
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += OnChanged;
        await Auth.InitializeAsync();
        _ready = true;
        if (!Auth.Enabled)
        {
            Navigation.NavigateTo("");
        }
    }

    private async Task SubmitAsync()
    {
        _success = false;
        _warning = null;
        _error = null;

        if (string.IsNullOrEmpty(_form.CurrentPassword) || string.IsNullOrEmpty(_form.NewPassword))
        {
            _error = "Enter your current password and a new password.";
            return;
        }

        if (_form.NewPassword != _form.ConfirmPassword)
        {
            _error = "The new password and its confirmation do not match.";
            return;
        }

        _busy = true;
        try
        {
            var result = await Auth.ChangePasswordAsync(_form.CurrentPassword, _form.NewPassword);
            _error = result.Error;
            _warning = result.Warning;
        }
        finally
        {
            _busy = false;
        }

        if (_error is null)
        {
            _success = true;
            _form.CurrentPassword = string.Empty;
            _form.NewPassword = string.Empty;
            _form.ConfirmPassword = string.Empty;
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Auth.Changed -= OnChanged;

    private sealed class ChangePasswordForm
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
