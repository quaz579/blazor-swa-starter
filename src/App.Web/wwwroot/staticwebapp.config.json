{
  "platform": {
    "apiRuntime": "dotnet-isolated:10.0"
  },
  "routes": [
    {
      "route": "/api/__test/*",
      "allowedRoles": ["seed-reset-disabled"]
    },
    {
      "route": "/version.json",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/api/items",
      "methods": ["POST"],
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/items/*",
      "methods": ["DELETE"],
      "allowedRoles": ["authenticated"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/version.json",
      "/images/*.{png,jpg,gif}",
      "/css/*",
      "/api/*"
    ]
  }
}
