<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <StaticWebAssetContentTypeMapping Include="application/json" Pattern="version.json" Cache="no-store" Priority="0" />
  </ItemGroup>

  <ItemGroup Condition="Exists('obj/version-marker/index.html')">
    <Content Remove="wwwroot/index.html" />
    <Content Include="obj/version-marker/index.html" Link="wwwroot/index.html" TargetPath="wwwroot/index.html" ContentRoot="$(MSBuildProjectDirectory)/obj/version-marker/" />
    <Content Include="obj/version-marker/version.json" Link="wwwroot/version.json" TargetPath="wwwroot/version.json" ContentRoot="$(MSBuildProjectDirectory)/obj/version-marker/" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App.Core\App.Core.csproj" />
  </ItemGroup>

  <UsingTask TaskName="IdentifyLegacyVersionMarker" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Path ParameterType="System.String" Required="true" />
      <Generated ParameterType="System.Boolean" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Generated = false;
        try
        {
          if ((System.IO.File.GetAttributes(Path) & System.IO.FileAttributes.ReparsePoint) != 0) return true;
          var json = System.Reflection.Assembly.Load("System.Text.Json");
          var documentType = json.GetType("System.Text.Json.JsonDocument");
          var optionsType = json.GetType("System.Text.Json.JsonDocumentOptions");
          using (var document = (System.IDisposable)documentType.GetMethod("Parse", new[] { typeof(string), optionsType }).Invoke(null, new[] { System.IO.File.ReadAllText(Path), System.Activator.CreateInstance(optionsType) }))
          {
            var value = documentType.GetProperty("RootElement").GetValue(document);
            var elementType = value.GetType();
            if (elementType.GetProperty("ValueKind").GetValue(value).ToString() == "Object")
            {
              var properties = (System.Collections.IEnumerable)elementType.GetMethod("EnumerateObject").Invoke(value, null);
              var keys = properties.Cast<object>().Select(p => (string)p.GetType().GetProperty("Name").GetValue(p)).Distinct().OrderBy(n => n);
              var sha = elementType.GetMethod("GetProperty", new[] { typeof(string) }).Invoke(value, new object[] { "sha" });
              Generated = keys.SequenceEqual(new[] { "built_at", "run_attempt", "sha", "starter_tag", "workflow_run_id" })
                && elementType.GetProperty("ValueKind").GetValue(sha).ToString() == "String"
                && System.Text.RegularExpressions.Regex.IsMatch((string)elementType.GetMethod("GetString").Invoke(sha, null), @"\A(?:[a-f0-9]{40}|local)\z");
            }
          }
          if (Generated)
          {
            using (var git = new System.Diagnostics.Process())
            {
              git.StartInfo = new System.Diagnostics.ProcessStartInfo("git") { WorkingDirectory = System.IO.Path.GetDirectoryName(Path), UseShellExecute = false, RedirectStandardOutput = true, RedirectStandardError = true };
              git.StartInfo.Arguments = "ls-files --error-unmatch -- version.json";
              git.Start();
              git.WaitForExit();
              Generated = git.ExitCode != 0;
            }
          }
        }
        catch { Generated = false; }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ResolveLegacyVersionMarker" BeforeTargets="AssignTargetPaths" Condition="Exists('wwwroot/version.json')">
    <IdentifyLegacyVersionMarker Path="$(MSBuildProjectDirectory)/wwwroot/version.json">
      <Output TaskParameter="Generated" PropertyName="LegacyVersionMarkerGenerated" />
    </IdentifyLegacyVersionMarker>
    <Error Condition="'$(LegacyVersionMarkerGenerated)' != 'true' and Exists('obj/version-marker/index.html')"
           Text="User file wwwroot/version.json conflicts with generated obj/version-marker/version.json. Rename or remove wwwroot/version.json, or remove obj/version-marker to serve the user file." />
    <ItemGroup Condition="'$(LegacyVersionMarkerGenerated)' == 'true'">
      <Content Remove="wwwroot/version.json" />
    </ItemGroup>
  </Target>

  <Target Name="CleanVersionMarker" AfterTargets="Clean">
    <RemoveDir Directories="$(MSBuildProjectDirectory)/obj/version-marker" />
  </Target>

</Project>
